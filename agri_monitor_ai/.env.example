# Configuration de l'API
API_HOST=0.0.0.0
API_PORT=8080

# Configuration de la base de données PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agri_monitor

# Configuration de MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agri_monitor

# Configuration d'InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=mytoken
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=agri_monitor

# Chemins des modèles
DISEASE_SENSOR_MODEL_PATH=models/disease_sensor_model.bin
DISEASE_IMAGE_MODEL_PATH=models/disease_image_model.bin
WATER_SENSOR_MODEL_PATH=models/water_sensor_model.bin
WATER_IMAGE_MODEL_PATH=models/water_image_model.bin
FERTILITY_SENSOR_MODEL_PATH=models/fertility_sensor_model.bin
FERTILITY_IMAGE_MODEL_PATH=models/fertility_image_model.bin
AIR_QUALITY_SENSOR_MODEL_PATH=models/air_quality_sensor_model.bin
AIR_QUALITY_IMAGE_MODEL_PATH=models/air_quality_image_model.bin
PROFITABILITY_SENSOR_MODEL_PATH=models/profitability_sensor_model.bin
PROFITABILITY_IMAGE_MODEL_PATH=models/profitability_image_model.bin
PRODUCTION_DATE_SENSOR_MODEL_PATH=models/production_date_sensor_model.bin
PRODUCTION_DATE_IMAGE_MODEL_PATH=models/production_date_image_model.bin
PRODUCTION_RATE_SENSOR_MODEL_PATH=models/production_rate_sensor_model.bin
PRODUCTION_RATE_IMAGE_MODEL_PATH=models/production_rate_image_model.bin
DISASTER_SENSOR_MODEL_PATH=models/disaster_sensor_model.bin
DISASTER_IMAGE_MODEL_PATH=models/disaster_image_model.bin

# Configuration du logging
RUST_LOG=info

